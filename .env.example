# ==================================================
# LingoLoop Application Environment Configuration Example
# Copy this file to '.env' and fill in your values.
# DO NOT place real secrets in this example file.
# ==================================================

# Frontend / App Details
VITE_APP_NAME=VithAI
VITE_API_URL=http://localhost:5000/api

# Supabase Backend & Database Credentials (Optional)
# Obtain these from your Supabase project dashboard (Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI Tutor API Configuration (Optional)
# Google Gemini API key: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (Backup AI Provider): https://console.groq.com/
VITE_GROQ_API_KEY=your_groq_api_key_here
