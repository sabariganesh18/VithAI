# ==================================================
# VithAI Application Environment Configuration Template
# ==================================================

# Application & Host URLs
VITE_APP_NAME=VithAI
VITE_FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:5000
VITE_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
VITE_API_URL=http://localhost:5000/api

# Google OAuth Configuration (Google Cloud Console Credentials)
# In Google Cloud Console:
# - Authorized JavaScript Origins: http://localhost:5173, http://localhost:5000
# - Authorized Redirect URIs: https://<your-supabase-project-id>.supabase.co/auth/v1/callback, http://localhost:5173/auth/callback
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase Database & Auth Configuration
# In Supabase Dashboard -> Authentication -> URL Configuration:
# - Site URL: http://localhost:5173
# - Redirect URLs: http://localhost:5173/**, http://localhost:5173/auth/callback
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Tutor API Configuration (Optional)
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GROQ_API_KEY=your-groq-api-key
